<!--\\ 
    Using the pagepiling plugin for sectioning.
    More info at https://github.com/alvarotrigo/pagePiling.js/
    \\-->
<div id="pagepiling">
    <!-- first section - main -->
    <div class="section">
        <div class="paintbrush-palette">
            <img src="/images/brush.png" alt="Paintbrush" class="paintbrush">
            <img src="/images/palette.png" alt="Palette" class="palette">
            <button type="button" class="pick-colors-button" aria-label="Pick colors" title="Pick colors">
                <svg class="dropper-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="m2 22 1-1h3l9-9"/>
                    <path d="M3 21v-3l9-9"/>
                    <path d="m15 6 3.4-3.4a2.1 2.1 0 1 1 3 3L18 9l.4.4a2.1 2.1 0 1 1-3 3l-3.8-3.8a2.1 2.1 0 1 1 3-3l.4.4Z"/>
                </svg>
            </button>
        </div>
        <div class="color-picker">

        </div>
    </div>
    <!-- /main -->
    <!-- second section - about -->
    <div class="section">
        <div class="page-2-wrapper">
            <div class="about">
                <h1>About</h1>
                <p>
                    This is a simple app utilizing the <a href="https://github.com/bgrins/TinyColor">TinyColor API</a> that takes an input color and softens it for you.
                </p>
            </div>
        </div>
        <footer>
            <p>&copy; 2017-2026 - Designed by <a href="https://mlee.app">Michael Lee</a></p>
        </footer>
    </div>
    <!-- /about -->
</div>
